# Copy file này thành `.env` rồi điền giá trị thật:
#     Copy-Item env.example .env
# `.env` nằm trong .gitignore. KHÔNG commit nó.

# ============ app ============
APP_ENV=dev
APP_TZ=Asia/Ho_Chi_Minh
LOG_LEVEL=INFO

# ============ database ============
# Field rời, không phải DSN: password chứa @ : / # % sẽ âm thầm phá DSN viết tay.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=xingke
DB_USER=xingke_app
DB_PASSWORD=change-me
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_ECHO=false
# Override cho Alembic/CI; thắng khi được set
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/xingke

# ============ ingestion ============
SCHEDULER_ENABLED=true
INGEST_INTERVAL_MINUTES=10
INGEST_JITTER_SECONDS=30
# Fetch hôm nay + N ngày trước (theo giờ VENDOR). Phủ biên giới UTC+7 / UTC+8.
INGEST_DAYS_BACK=1
# false: tránh bão ingest mỗi lần save file khi chạy --reload
INGEST_ON_STARTUP=false
INGEST_MAX_CONSECUTIVE_FAILURES=10
STORE_RAW_PAYLOAD=true

# ============ status / alert ============
# 90 phút = 3 sample bị mất. Cadence vendor đã đo từ dữ liệu thật = 30 phút.
ONLINE_STALE_MINUTES=90
ALERT_LOW_VOLUME_PERCENT=15
ALERT_LOW_BATTERY_V=3.40
ALERT_LOW_SIGNAL_PERCENT=10
DEFAULT_TANK_CAPACITY_L=10425

# ============ dự báo / kế hoạch nạp ============
# MỌI biến trong khối này VÀ khối thông báo bên dưới đều sửa được trong app tại
# trang Cài đặt, và giá trị đặt trong app THẮNG giá trị ở đây. Những dòng dưới
# chỉ là giá trị khởi tạo cho lần triển khai đầu, trước khi có ai đăng nhập.
# Xem app/services/appconfig.py (danh sách OVERRIDABLE).

# Cửa sổ lịch sử dùng để suy mức tiêu thụ/ngày.
FORECAST_WINDOW_DAYS=30
# Mức dự trữ tính theo % dung tích bồn.
FORECAST_RESERVE_PERCENT=15
# Thời gian từ lúc đặt tới lúc xe tới (ngày). Đầu vào của điểm đặt hàng lại.
FORECAST_LEAD_TIME_DAYS=1
# Mức phục vụ cho dự trữ an toàn. Chỉ nhận 50 | 80 | 90 | 95 | 99.
FORECAST_SERVICE_LEVEL=95
# Lần đo cũ hơn mức này thì dự báo bị đánh dấu lỗi thời và KHÔNG phát cảnh báo
# runout / thời gian giữ áp. Cố ý rộng hơn nhiều ONLINE_STALE_MINUTES.
FORECAST_MAX_READING_AGE_HOURS=24
# Áp suất van an toàn của bồn (MPa). PHẢI khớp thông số bồn thật — đây là cơ sở
# tính thời gian giữ áp.
LNG_RELIEF_PRESSURE_MPA=0.8
# Trần rót: bồn lạnh sâu chừa khoảng hơi cho giãn nở nhiệt.
LNG_MAX_FILL_PERCENT=90
# Sức chứa xe bồn (lít), dùng khi lập lịch giao.
TRUCK_CAPACITY_L=20000

# ============ thông báo (email) ============
# SMTP thuần, không SDK của nhà cung cấp nào: không phát sinh chi phí và dùng
# được với bất kỳ hộp thư công ty đã có. Thiếu cấu hình thì hệ thống ghi log rồi
# bỏ qua — KHÔNG làm vòng ingest thất bại.
NOTIFY_ENABLED=true
# smtp.gmail.com cần "mật khẩu ứng dụng" 16 ký tự, không phải mật khẩu tài khoản.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# true cho cổng 587 (STARTTLS); false cho cổng 465 (SSL/TLS ngay từ đầu).
SMTP_STARTTLS=true
# Nhiều địa chỉ phân tách bằng dấu phẩy.
ALERT_EMAIL_TO=
# Không nhắc lại cùng một (bồn, mã cảnh báo) trong khoảng này. Không có cửa chặn
# thì một bồn cạn sẽ sinh 144 email/ngày và người nhận sẽ lọc vào thùng rác.
ALERT_RESEND_HOURS=12

# ============ api ============
API_HOST=127.0.0.1
API_PORT=8000
# Rỗng => same-origin (FastAPI serve dashboard). Không bao giờ dùng "*".
CORS_ORIGINS=
EXPOSE_RAW_PAYLOAD=false
ADMIN_TOKEN=change-me
# Cookie phiên dashboard. Tạo bằng:
#   .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-session-secret
SESSION_HOURS=12
MAX_HISTORY_LIMIT=1000
MAX_HISTORY_SPAN_DAYS=90

# ============ vendor adapter ============
# Chỉ còn adapter "live" — adapter giả đã bị bỏ khỏi sản phẩm, nay chỉ tồn tại
# trong tests/stub_adapter.py cho test. Giữ biến này để tương thích cấu hình cũ.
XINGKE_ADAPTER=live

# BẮT BUỘC. Đã xác minh 2026-08-18: device/list của vendor trả về 3543 thiết bị
# của MỌI khách hàng, bỏ qua org scope của account (orgName='Gas LNG'). Chỉ
# ingest PSN trong danh sách này; phần còn lại bị drop ở ranh giới adapter và
# được đếm vào log.
XINGKE_ALLOWED_PSNS=2604200016,2605090007

XINGKE_BASE_URL=https://www.xk-iot.cn/ls/
# Đã xác minh thực nghiệm 2026-08-18: server render naive timestamp ở UTC+8,
# KHÔNG phải UTC+7. Đổi giá trị này nếu verify_tz.py chứng minh ngược lại.
XINGKE_VENDOR_TZ=Asia/Shanghai
XINGKE_TIMEOUT_SECONDS=30
# Throttle lịch sự: vendor có bảng audit login/operation.
XINGKE_MIN_INTERVAL_SECONDS=1.0
# Guard chống loop vô hạn đập vào admin API nếu parse sai `total`.
XINGKE_MAX_PAGES=50
# 100 = max UI của vendor. Đừng vượt.
XINGKE_PAGE_SIZE=100

# Auth: token thắng nếu được set (hotfix qua .env không cần sửa code).
# Token = giá trị localStorage.token trong browser. Đã xác minh: UUID 36 ký tự,
# KHÔNG phải JWT => opaque, session server-side, không decode được expiry.
XINGKE_TOKEN=
XINGKE_USERNAME=
XINGKE_PASSWORD=

# Probe: KHÔNG dùng hôm nay — cả 2 thiết bị đã offline hàng tháng nên
# queryTime=today trả rỗng và rất dễ chẩn đoán sai thành "auth lỗi".
XINGKE_PROBE_PSN=2604200016
XINGKE_PROBE_DATE=2026-07-23

# Nguồn đo phút thứ hai. Tắt mặc định — bật tường minh khi đã chốt dung tích
# 60 000 L và cron ngày (không poll 10 phút). Chỉ GET; không có endpoint ghi.
# BASE_URL để trống trong repo vì cổng nguồn không có xác thực — điền trong .env.
YOKOHAMA_ENABLED=false
YOKOHAMA_BASE_URL=
YOKOHAMA_PSN=YKH-TANK-01
YOKOHAMA_SITE_CODE=YKH
YOKOHAMA_VENDOR_TZ=Asia/Ho_Chi_Minh
YOKOHAMA_MAX_STREAM_BYTES=8388608
# Một NỬA maxDuration của function trong vercel.json (60 s), không phải bằng nó:
# cycle còn phải fetch nguồn kia và ghi DB sau khi stream xong.
YOKOHAMA_MAX_STREAM_SECONDS=25

# ============ vercel / serverless deploy ============
# Bí mật cho Vercel Cron gọi /api/cron/ingest. Vercel tự gắn header
# "Authorization: Bearer <CRON_SECRET>" khi biến này được set trong dashboard.
CRON_SECRET=change-me-cron-secret
# LƯU Ý khi deploy Vercel (đặt trong Environment Variables, không phải file này):
#   SCHEDULER_ENABLED=false   -> serverless không giữ process nền; cron thay thế
#   DATABASE_URL=...          -> trỏ endpoint POOLED (Neon pooled / pgbouncer)
#   SESSION_SECRET, ADMIN_TOKEN, CRON_SECRET, XINGKE_* -> set giá trị thật
