# Copy file này thành `.env` rồi điền giá trị thật:
#     Copy-Item env.example .env
# `.env` nằm trong .gitignore. KHÔNG commit nó.

# ============ app ============
APP_ENV=dev
APP_TZ=Asia/Ho_Chi_Minh
LOG_LEVEL=INFO

# ============ database ============
# Field rời, không phải DSN: password chứa @ : / # % sẽ âm thầm phá DSN viết tay.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=xingke
DB_USER=xingke_app
DB_PASSWORD=change-me
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_ECHO=false
# Override cho Alembic/CI; thắng khi được set
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/xingke

# ============ ingestion ============
SCHEDULER_ENABLED=true
INGEST_INTERVAL_MINUTES=10
INGEST_JITTER_SECONDS=30
# Fetch hôm nay + N ngày trước (theo giờ VENDOR). Phủ biên giới UTC+7 / UTC+8.
INGEST_DAYS_BACK=1
# false: tránh bão ingest mỗi lần save file khi chạy --reload
INGEST_ON_STARTUP=false
INGEST_MAX_CONSECUTIVE_FAILURES=10
STORE_RAW_PAYLOAD=true

# ============ status / alert ============
# 90 phút = 3 sample bị mất. Cadence vendor đã đo từ dữ liệu thật = 30 phút.
ONLINE_STALE_MINUTES=90
ALERT_LOW_VOLUME_PERCENT=15
ALERT_LOW_BATTERY_V=3.40
ALERT_LOW_SIGNAL_PERCENT=10
DEFAULT_TANK_CAPACITY_L=10425

# ============ api ============
API_HOST=127.0.0.1
API_PORT=8000
# Rỗng => same-origin (FastAPI serve dashboard). Không bao giờ dùng "*".
CORS_ORIGINS=
EXPOSE_RAW_PAYLOAD=false
ADMIN_TOKEN=change-me
# Cookie phiên dashboard. Tạo bằng:
#   .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-session-secret
SESSION_HOURS=12
MAX_HISTORY_LIMIT=1000
MAX_HISTORY_SPAN_DAYS=90

# ============ vendor adapter ============
# fake = chạy trên fixture, không cần credential. live = gọi vendor thật.
XINGKE_ADAPTER=fake

# BẮT BUỘC. Đã xác minh 2026-08-18: device/list của vendor trả về 3543 thiết bị
# của MỌI khách hàng, bỏ qua org scope của account (orgName='Gas LNG'). Chỉ
# ingest PSN trong danh sách này; phần còn lại bị drop ở ranh giới adapter và
# được đếm vào log.
XINGKE_ALLOWED_PSNS=2604200016,2605090007

XINGKE_BASE_URL=https://www.xk-iot.cn/ls/
# Đã xác minh thực nghiệm 2026-08-18: server render naive timestamp ở UTC+8,
# KHÔNG phải UTC+7. Đổi giá trị này nếu verify_tz.py chứng minh ngược lại.
XINGKE_VENDOR_TZ=Asia/Shanghai
XINGKE_TIMEOUT_SECONDS=30
# Throttle lịch sự: vendor có bảng audit login/operation.
XINGKE_MIN_INTERVAL_SECONDS=1.0
# Guard chống loop vô hạn đập vào admin API nếu parse sai `total`.
XINGKE_MAX_PAGES=50
# 100 = max UI của vendor. Đừng vượt.
XINGKE_PAGE_SIZE=100

# Auth: token thắng nếu được set (hotfix qua .env không cần sửa code).
# Token = giá trị localStorage.token trong browser. Đã xác minh: UUID 36 ký tự,
# KHÔNG phải JWT => opaque, session server-side, không decode được expiry.
XINGKE_TOKEN=
XINGKE_USERNAME=
XINGKE_PASSWORD=

# Probe: KHÔNG dùng hôm nay — cả 2 thiết bị đã offline hàng tháng nên
# queryTime=today trả rỗng và rất dễ chẩn đoán sai thành "auth lỗi".
XINGKE_PROBE_PSN=2604200016
XINGKE_PROBE_DATE=2026-07-23
